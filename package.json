{
  "name": "agsb-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start-dev": "nodemon index.js",
    "start-stage": "node -r dotenv/config index.js dotenv_config_path=.env.stage",
    "start-stage-dev": "nodemon -r dotenv/config index.js dotenv_config_path=.env.stage",
    "seed:admin:stage": "node -r dotenv/config src/scripts/seedAdmin.js dotenv_config_path=.env.stage",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "seed:content": "node src/scripts/seedContent.js",
    "migrate:premium-frames": "node src/scripts/protectPremiumFrames.js",
    "migrate:premium-frames:stage": "node -r dotenv/config src/scripts/protectPremiumFrames.js dotenv_config_path=.env.stage",
    "seed:districts": "node src/scripts/seedDistricts.js",
    "seed:districts:stage": "node -r dotenv/config src/scripts/seedDistricts.js dotenv_config_path=.env.stage",
    "images:districts": "node src/scripts/fetchDistrictImages.js",
    "images:districts:stage": "node -r dotenv/config src/scripts/fetchDistrictImages.js dotenv_config_path=.env.stage",
    "migrate:attractions": "node src/scripts/migrateAttractions.js",
    "migrate:attractions:stage": "node -r dotenv/config src/scripts/migrateAttractions.js dotenv_config_path=.env.stage",
    "fill:attractions": "node src/scripts/fillAttractionDetails.js",
    "fill:attractions:stage": "node -r dotenv/config src/scripts/fillAttractionDetails.js dotenv_config_path=.env.stage",
    "seed:products": "node src/scripts/seedProducts.js",
    "seed:products:stage": "node -r dotenv/config src/scripts/seedProducts.js dotenv_config_path=.env.stage",
    "seed:payment-methods": "node src/scripts/seedPaymentMethods.js",
    "seed:payment-methods:stage": "node -r dotenv/config src/scripts/seedPaymentMethods.js dotenv_config_path=.env.stage"
  },
  "author": "",
  "license": "ISC",
  "description": "AGSB (Ami Ghurechi) backend API",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.6.1",
    "multer": "^2.0.0",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
