# Set NODE_ENV=production in every deployed environment (Express then skips
# development-only behaviour such as verbose error pages).
NODE_ENV=development

# At least 32 characters; the server refuses to start otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

PORT=5001
# Required; the server refuses to start without it.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=agsb

# Set when running behind a reverse proxy (nginx, a PaaS router) so rate limits
# see the real client IP: the number of proxy hops (usually 1), or the proxy's
# address/subnet (e.g. 10.0.0.0/8). Never "true": clients could then spoof
# X-Forwarded-For. Leave unset when clients connect directly.
# TRUST_PROXY=1

# Comma-separated frontend origins allowed by CORS (defaults to localhost dev ports)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Minutes an unpaid booking holds its seats before they are released (default 60)
BOOKING_HOLD_MINUTES=60
