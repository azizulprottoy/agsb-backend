# Copy to .env.mail (gitignored) and fill in. Loaded by index.js after .env.
# cPanel mail on amighurisharabangladesh.com: SMTP 465 (SSL), IMAP 993 (SSL).
MAIL_HOST=amighurisharabangladesh.com
MAIL_SMTP_PORT=465
MAIL_IMAP_PORT=993

# One password per mailbox; a mailbox without one is shown as unconfigured
# and refuses to send. Automatic emails (welcome, password reset, bookings)
# go out from no-reply.
MAIL_NOREPLY_PASSWORD=noreply@agsb
MAIL_BUSINESS_PASSWORD=business@agsb
MAIL_SUPPORT_PASSWORD=support@agsb

# Optional: comma-separated addresses told about each new payment to verify.
MAIL_ADMIN_ALERT_TO=

# Shared secret for the CC Events delivery webhook (POST /api/events/deliver).
CC_EVENTS_WEBHOOK_SECRET=
